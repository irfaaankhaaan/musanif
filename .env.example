# Copy this file to ".env" and fill in the real values.
# Never share the .env file. It is your password drawer.

SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
GROK_API_KEY=xai-...
ZERNIO_API_KEY=sk_...

# Grok is free to start with. Two ways to get a key:
#   xAI       console.x.ai > API keys. The key starts with "xai-".
#   OpenRouter openrouter.ai/keys, which has a free Grok. The key starts
#             with "sk-or-", and you also need the two lines below.
# GROK_BASE_URL=https://openrouter.ai/api/v1
# GROK_MODEL=x-ai/grok-4-fast:free

# DRY_RUN=true  -> write the posts and show them to you, publish nothing.
# DRY_RUN=false -> actually publish to LinkedIn and Instagram.
DRY_RUN=true
